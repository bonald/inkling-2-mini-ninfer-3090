+template <int T>
+__global__ __launch_bounds__(256) void packed_down_4row_kernel(MoeVecArgs p) {
+    if (blockIdx.y >= *p.active_count) return;
+    const int expert = p.active[blockIdx.y], begin = p.bounds[expert], end = p.bounds[expert + 1];
+    constexpr int K = 1152;
+    constexpr int S = K / 32; // 36
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int row0 = blockIdx.x * 32 + warp * 4;
+    const unsigned* wptr[4];
+#pragma unroll
+    for (int r = 0; r < 4; ++r) {
+        wptr[r] = reinterpret_cast<const unsigned*>(
+            p.first[expert] + std::int64_t(row0 + r) * p.row_bytes);
+    }
+    __shared__ int aq[T][8][S + 1];
+    __shared__ float scale[T][S];
+    for (int c0 = begin; c0 < end; c0 += T) {
+        const int n = min(T, end - c0);
+        int pair[T];
+#pragma unroll
+        for (int j = 0; j < T; ++j) pair[j] = p.sorted[c0 + min(j, n - 1)];
+        for (int j = 0; j < n; ++j) {
+            const int col = pair[j] / p.column_group;
+            const auto* q = reinterpret_cast<const int*>(p.qs + std::int64_t(col) * K);
+            for (int i = threadIdx.x; i < K / 4; i += 256) aq[j][i % 8][i / 8] = q[i];
+            if (threadIdx.x < S)
+                scale[j][threadIdx.x] = __low2float(p.ds[std::int64_t(col) * S + threadIdx.x]);
+        }
+        __syncthreads();
+        float acc[4][T]{};
+        // Main coalesced slices s = 0..31: load activations once into registers, reuse across 4 rows.
+        int a_reg[T][8];
+        float sc_reg[T];
+        for (int j = 0; j < n; ++j) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) a_reg[j][i] = aq[j][i][lane];
+            sc_reg[j] = scale[j][lane];
+        }
+#pragma unroll
+        for (int r = 0; r < 4; ++r) {
+            const unsigned* words = wptr[r];
+            int w[8];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                const int2 z               = inkling_unpack(words[i * S + lane]);
+                w[4 * (i / 2) + i % 2]     = z.x;
+                w[4 * (i / 2) + 2 + i % 2] = z.y;
+            }
+            const unsigned d  = reinterpret_cast<const unsigned short*>(words + 4 * S)[lane];
+            const unsigned lo = d & 255u, hi = d >> 8;
+            const unsigned pairbits =
+                ((lo == 255u ? 0u : lo) << 7) | ((hi == 255u ? 0u : hi) << 23);
+            const float2 ds = __half22float2(*reinterpret_cast<const half2*>(&pairbits));
+            const float a = ds.x, b = ds.y;
+            for (int j = 0; j < n; ++j) {
+                int v0 = 0, v1 = 0;
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    v0 = __dp4a(w[i], a_reg[j][i], v0);
+                    v1 = __dp4a(w[4 + i], a_reg[j][4 + i], v1);
+                }
+                acc[r][j] = __fmul_rn(sc_reg[j],
+                                      __fadd_rn(__fmul_rn(a, float(v0)), __fmul_rn(b, float(v1))));
+            }
+        }
+        // Packed tail pass: s = 32..35 across all 4 rows simultaneously on lanes 0..15,
+        // then shuffled onto lanes 0..3 so floating-point addition order is bit-exact with packed_kernel.
+        float tv[T]{};
+        if (lane < 16) {
+            const int tr          = lane >> 2;
+            const int ts          = 32 + (lane & 3);
+            const unsigned* words = wptr[tr];
+            int w[8];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                const int2 z               = inkling_unpack(words[i * S + ts]);
+                w[4 * (i / 2) + i % 2]     = z.x;
+                w[4 * (i / 2) + 2 + i % 2] = z.y;
+            }
+            const unsigned d  = reinterpret_cast<const unsigned short*>(words + 4 * S)[ts];
+            const unsigned lo = d & 255u, hi = d >> 8;
+            const unsigned pairbits =
+                ((lo == 255u ? 0u : lo) << 7) | ((hi == 255u ? 0u : hi) << 23);
+            const float2 ds = __half22float2(*reinterpret_cast<const half2*>(&pairbits));
+            const float a = ds.x, b = ds.y;
+            for (int j = 0; j < n; ++j) {
+                int v0 = 0, v1 = 0;
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    v0 = __dp4a(w[i], aq[j][i][ts], v0);
+                    v1 = __dp4a(w[4 + i], aq[j][4 + i][ts], v1);
+                }
+                tv[j] = __fmul_rn(scale[j][ts],
+                                  __fadd_rn(__fmul_rn(a, float(v0)), __fmul_rn(b, float(v1))));
+            }
+        }
+        for (int j = 0; j < n; ++j) {
+#pragma unroll
+            for (int r = 0; r < 4; ++r) {
+                const float tval = __shfl_sync(0xffffffff, tv[j], 4 * r + (lane & 3));
+                if (lane < 4) acc[r][j] += tval;
+            }
+        }
+        // Warp-reduce all 4 rows; lanes 0..3 issue coalesced writes/atomics for row0..row0+3.
+        for (int j = 0; j < n; ++j) {
+            float v_out = 0.0f;
+#pragma unroll
+            for (int r = 0; r < 4; ++r) {
+                float v = acc[r][j];
+#pragma unroll
+                for (int delta = 16; delta > 0; delta >>= 1)
+                    v += __shfl_xor_sync(0xffffffff, v, delta);
+                if (lane == r) v_out = v;
+            }
+            if (lane < 4) {
+                const int row = row0 + lane;
+                if (p.weighted)
+                    atomicAdd(
+                        p.weighted + std::int64_t(pair[j] / p.per_token) * p.rows + row,
+                        static_cast<unsigned long long>(fixed_product(v_out, p.weights[pair[j]])));
+                else
+                    p.out_f32[std::int64_t(pair[j]) * p.rows + row] = v_out;
+            }
+        }
+        __syncthreads();
+    }
+}
