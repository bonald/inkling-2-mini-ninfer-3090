new file mode 100644
index 0000000..948d99e
--- /dev/null
+++ b/src/models/inkling2/kv_format.cpp
@@ -0,0 +1,40 @@
+#include "models/inkling2/kv_format.h"
+
+#include "models/kv_storage_name.h"
+
+#include <stdexcept>
+#include <string>
+
+namespace ninfer::models::inkling2 {
+
+KvFormat kv_format(KvCacheStorage storage) {
+    constexpr KvPlane f16{};
+    switch (storage) {
+    // The unquantized cache is F16, which --kv-dtype fp16 names and bf16 (the default) selects.
+    case KvCacheStorage::BFloat16:
+    case KvCacheStorage::Float16: return {storage, f16, f16};
+    // The eight full-attention visits only: int8 G64 keys and values.
+    case KvCacheStorage::Int8Group64: return {storage, {KvCoding::Int8G64}, {KvCoding::Int8G64}};
+    // rk8v4: int8 G64 keys, packed int4 G32 values.
+    case KvCacheStorage::RotatedInt8KeyInt4ValueGroup64:
+        return {storage, {KvCoding::Int8G64}, {KvCoding::Int4G32}};
+    // rk4v4: 4-bit Lloyd-Max keys over the same value plane.
+    case KvCacheStorage::RotatedLloyd4KeyInt4Value:
+        return {storage, {KvCoding::Lloyd4}, {KvCoding::Int4G32}};
+    // mxfp8: the release's MXFP8 keys and values.
+    case KvCacheStorage::Mxfp8: return {storage, {KvCoding::Mxfp8}, {KvCoding::Mxfp8}};
+    case KvCacheStorage::Fp8E4M3Row256:
+    case KvCacheStorage::Nvfp4Group16:
+    case KvCacheStorage::Fp8KeyNvfp4Value:
+    case KvCacheStorage::RotatedInt4KeyInt4ValueE8:
+    case KvCacheStorage::RotatedE8RootKeyInt4Value:
+    case KvCacheStorage::Bf16Packed:
+        throw std::invalid_argument(
+            "Inkling 2: --kv-dtype " + std::string(kv_storage_name(storage)) +
+            " is not built for this family (mxfp8, the default, int8, rk8v4 or rk4v4, or the F16 "
+            "cache: bf16 or fp16)");
+    }
+    throw std::invalid_argument("Inkling 2: unknown KV-cache storage");
+}
+
+} // namespace ninfer::models::inkling2
diff --git a/tmp/ninfer-clean-mod/src/models/inkling2/kv_format.h b/src/models/inkling2/kv_format.h
new file mode 100644
index 0000000..d7a23c1
--- /dev/null
+++ b/src/models/inkling2/kv_format.h
@@ -0,0 +1,49 @@
+#pragma once
+
+// Inkling 2's KV-cache storage (--kv-dtype). A cache row is one KV head of one position, its
+// 128 values in one block: codes and scales in two planes of a visit (executor.cpp). The codings
+// are the engine's 128-wide row codings (ops/kv_cache/row128.h): Int8G64, Int4G32, Lloyd4 and
+// MXFP8.
+//
+// Only the eight full-attention visits store planes (int8: Int8G64 keys and values; rk8v4:
+// Int8G64 keys and Int4G32 values; rk4v4: Lloyd4 keys and Int4G32 values; mxfp8: Mxfp8 keys and
+// values); the windowed visits' rings, the convolution histories and the DSpark drafter's caches
+// stay F16 whatever the flag says. Rounding the rings' rows to MXFP8 as well raised WikiText's
+// mean NLL (+0.029% against +0.024% over 67,977 tokens, +0.091% against +0.015% over 9,718) and
+// saves no memory, since a ring's size does not grow with the context. The rows are stored
+// unrotated: Inkling's K and V come out of their convolutions clipped and RMS-normed, and rotating
+// the keys as Flint's rk4v4 does (row128.h) raised the mean NLL over 67,977 tokens, rk8v4's from
+// 1.784735 to 1.784842 and rk4v4's from 1.785611 to 1.785690.
+
+#include "ninfer/kv_cache_storage.h"
+#include "ops/kv_cache/row128.h"
+
+#include <cstdint>
+
+namespace ninfer::models::inkling2 {
+
+using ops::kv128::KvCoding;
+using ops::kv128::kKvRowDims;
+using ops::kv128::kv_code_bytes;
+using ops::kv128::kv_scale_bytes;
+using ops::kv128::KvPlaneView;
+
+struct KvPlane {
+    KvCoding coding = KvCoding::F16;
+};
+
+struct KvFormat {
+    KvCacheStorage storage = KvCacheStorage::BFloat16;
+    KvPlane key, value;
+    [[nodiscard]] bool quantized() const noexcept {
+        return storage != KvCacheStorage::BFloat16 && storage != KvCacheStorage::Float16;
+    }
+    // MXFP8: kv_post encodes the full visits' planes itself; the other quantized formats stage
+    // F16 rows for kv_store.
+    [[nodiscard]] bool mxfp8() const noexcept { return storage == KvCacheStorage::Mxfp8; }
+    [[nodiscard]] bool staged() const noexcept { return quantized() && !mxfp8(); }
+};
+
+[[nodiscard]] KvFormat kv_format(KvCacheStorage storage);
+
+} // namespace ninfer::models::inkling2
